{$DOMINIO::80} {
	root * /srv/frontend
	encode gzip

	@api path /api /api/*

	handle @api {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle {
		try_files {path} /indice.html
		file_server {
			index indice.html
		}
	}
}

{$DIDAXIA_ALIAS_CADDY:www.didaxia.pro} {
	redir {$ORIGEN_PUBLICO:https://didaxia.pro}{uri} permanent
}

{$DOMINIO_PUBLICO::8081} {
	root * /srv/frontend
	encode gzip

	@api path /api /api/*

	handle @api {
		respond "El API del tutor no se sirve en este dominio." 404 {
			close
		}
	}

	@textoPublico path /robots.txt /llms.txt /llm.txt
	handle @textoPublico {
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}

	handle {
		try_files {path} /indice.html
		file_server {
			index indice.html
		}
	}
}
