# DidaxIA · plantilla de configuración
# Copie este archivo como .env y reemplace los valores marcados.
# .env está ignorado por Git y por el contexto de construcción de Docker.

# PostgreSQL. AGENTE_BD usa el nombre del servicio interno de Compose: base.
PGPASSWORD_AGENTE=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA
AGENTE_BD=postgresql://agente:REEMPLAZAR_CON_LA_MISMA_CLAVE@base:5432/agente

# Generador de lenguaje
AGENTE_LLM=deepseek
AGENTE_LLM_MODELO=
AGENTE_LLM_TIEMPO_MAXIMO_S=60
# Conserva tareas, consultas paralelas y pasos comprobados en PostgreSQL.
AGENTE_CONTINUIDAD_TUTOR=1
DEEPSEEK_API_KEY=REEMPLAZAR_CON_LA_CLAVE_DEL_PROVEEDOR

# Identidad institucional
GOOGLE_CLIENT_ID=REEMPLAZAR_CON_EL_CLIENT_ID
DOMINIO_INSTITUCIONAL=universidad.example
DOCENTES_AUTORIZADOS=
# Núcleo inamovible del gobierno. Use correos institucionales reales sólo en .env.
INVESTIGADORES_PROPIETARIOS=operador@universidad.example
# Compatibilidad transitoria con despliegues anteriores; normalmente se deja vacía.
INVESTIGADORES_AUTORIZADOS=

# Avisos por correo. Se pueden dejar vacíos mientras el canal no esté activo.
RESEND_API_KEY=
RESEND_REMITENTE=
CORREO_PRIVACIDAD=
# Uno o varios buzones oficiales, separados por coma. No es un secreto.
CORREO_INVESTIGACION=

# Dominios y borde de producción
DOMINIO=app.didaxia.universidad.example
DOMINIO_PUBLICO=didaxia.universidad.example
ORIGEN_APLICACION=https://app.didaxia.universidad.example
ORIGEN_PUBLICO=https://didaxia.universidad.example
DIDAXIA_IP_PUBLICACION=0.0.0.0
DIDAXIA_PUERTO_HTTP=80
DIDAXIA_PUERTO_HTTPS=443

# VPS compartida detrás de un proxy institucional
DIDAXIA_DOMINIO_APP=app.didaxia.universidad.example
DIDAXIA_DOMINIO_PUBLICO=didaxia.universidad.example
DIDAXIA_DOMINIO_ALIAS=www.didaxia.universidad.example

# Docker local publica únicamente en 127.0.0.1.
DIDAXIA_PUERTO_APP_LOCAL=18080
DIDAXIA_PUERTO_PORTADA_LOCAL=18081

# Puertos del entorno local. Se pueden cambiar sin editar ningún YAML.
PUERTO_BD_DESARROLLO=5433
PUERTO_BD_PRODUCCION_LOCAL=15440
PUERTO_APP_PRODUCCION_LOCAL=18080
PUERTO_PUBLICO_PRODUCCION_LOCAL=18081
PUERTO_TLS_PRODUCCION_LOCAL=18443
PUERTO_BD_PRUEBAS=15433
PUERTO_BD_RESTAURACION=15434
HOST_BACKEND=127.0.0.1
PUERTO_BACKEND=8000

# Límites opcionales
AGENTE_LIMITE_SESION=20
AGENTE_LIMITE_IP=60
# Cupo compartido del tutor para cuentas autenticadas en la misma red del aula.
# Cada cuenta mantiene AGENTE_LIMITE_SESION incluso al abrir varias sesiones.
AGENTE_LIMITE_IP_AUTENTICADA=300
AGENTE_LIMITE_VENTANA_S=60
AGENTE_CAS_AISLAR=1
AGENTE_PILOTO_TESIS=1

# Las rutas internas de las custodias se fijan en Compose. En ejecución manual
# puede usarse una carpeta privada fuera del repositorio.
FOTOS_PERFIL_RUTA=
