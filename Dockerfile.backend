FROM python:3.11-slim AS build

WORKDIR /construccion

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip install --no-cache-dir --prefix=/instalado \
    --index-url https://download.pytorch.org/whl/cpu \
    --extra-index-url https://pypi.org/simple \
    -r requirements.txt

FROM python:3.11-slim AS base-app

RUN apt-get update && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 agente

COPY --from=build /instalado /usr/local

WORKDIR /app

COPY dominio/ dominio/
COPY adaptadores/ adaptadores/
COPY ingesta.py ./

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    HF_HOME=/cache-modelos

RUN mkdir -p /cache-modelos /app/infraestructura/registro_turnos /custodia/autorizaciones /custodia/fotos-perfil \
    && chown -R agente:agente /app /cache-modelos /custodia
USER agente

EXPOSE 8000

CMD ["uvicorn", "adaptadores.entrantes.http.aplicacion:app", "--host", "0.0.0.0", "--port", "8000"]

FROM base-app AS migraciones

USER root
COPY infraestructura/__init__.py infraestructura/
COPY infraestructura/migraciones/ infraestructura/migraciones/
COPY infraestructura/esquema/ infraestructura/esquema/
COPY infraestructura/operacion/__init__.py infraestructura/operacion/
COPY infraestructura/operacion/migrar_despliegue.py infraestructura/operacion/
COPY infraestructura/operacion/manifiesto_consentimiento.py infraestructura/operacion/
COPY infraestructura/operacion/publicar_consentimiento.py infraestructura/operacion/
COPY infraestructura/operacion/estado_consentimiento.py infraestructura/operacion/
COPY infraestructura/operacion/reanalizar_factores.py infraestructura/operacion/
RUN chown -R agente:agente /app/infraestructura
USER agente

CMD ["python", "-m", "infraestructura.operacion.migrar_despliegue"]

FROM base-app AS runtime
